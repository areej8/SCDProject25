# ============================================
# NodeVault Environment Configuration
# ============================================
# Copy this file to .env and update the values
# ============================================

# MongoDB Configuration
# =====================
# Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/nodevault

# MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nodevault?retryWrites=true&w=majority

# With authentication
# MONGODB_URI=mongodb://username:password@localhost:27017/nodevault?authSource=admin

# Application Configuration
# =========================
PORT=3000
NODE_ENV=development

# Backup Configuration
# ====================
BACKUP_DIR=./backups
MAX_BACKUPS=10

# Application Settings
# ====================
APP_NAME=NodeVault
LOG_LEVEL=info

# Optional: Alternative MongoDB Configuration
# ===========================================
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=nodevault
# MONGO_USER=
# MONGO_PASS=

# To construct MONGODB_URI from parts:
# MONGODB_URI=mongodb://${MONGO_USER}:${MONGO_PASS}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}
