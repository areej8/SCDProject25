# ============================================
# NodeVault Environment Configuration
# ============================================
# Copy this file to .env and update the values
# ============================================

# MongoDB Configuration
# =====================
MONGO_USERNAME=admin
MONGO_PASSWORD=your_password_here
MONGO_DATABASE=nodevault

# Application Configuration  
# =========================
APP_PORT=3000
NODE_ENV=production

# Backup Configuration
# ====================
BACKUP_DIR=./backups
MAX_BACKUPS=10

# Application Settings
# ====================
APP_NAME=NodeVault

# Docker Compose will construct MONGODB_URI from above:
# MONGODB_URI=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@mongodb:27017/${MONGO_DATABASE}?authSource=admin
